# ========================================================
# HOT RECHARGE ENTERPRISE API GATEWAY - ENVIRONMENT TEMPLATE
# Copy this file to .env and configure your credentials
# ========================================================

PORT=5000
NODE_ENV=development

# HOT Recharge V3 API Integration Settings
HOT_API_BASE_URL=https://ssl.hot.co.zw/api/v3
HOT_API_EMAIL=your_email@example.com
HOT_API_PASSWORD=your_api_password_here
HOT_API_AGENT_CODE=your_agent_code
HOT_MODE=sandbox # 'sandbox' for testing without live funds, 'live' for real production

# Database & Persistent Ledger
DATABASE_PATH=./data/hot_recharge_ledger.json
DATABASE_DRIVER=persistent_json_ledger

# Security & CORS
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=*

# WebSockets Push Gateway
WS_HEARTBEAT_INTERVAL=30000
