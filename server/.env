# ========================================================
# HOT RECHARGE ENTERPRISE API GATEWAY CONFIGURATION
# Computer Society of Zimbabwe (CSZ) Hackathon 2026
# Lead Architect: Brian Lupao (Africa University)
# ========================================================

PORT=5000
NODE_ENV=development

# HOT Recharge V3 API Integration Settings
# Official Base URL: https://ssl.hot.co.zw/api/v3
HOT_API_BASE_URL=https://ssl.hot.co.zw/api/v3
HOT_API_EMAIL=brianlupao123@gmail.com
HOT_API_PASSWORD=
HOT_API_AGENT_CODE=
HOT_MODE=sandbox

# Database & Persistent Ledger Configuration
DATABASE_PATH=./data/hot_recharge_ledger.json
DATABASE_DRIVER=persistent_json_ledger

# Security & CORS
JWT_SECRET=csz-2026-hot-recharge-secret-brian-lupao
CORS_ORIGIN=*

# WebSockets Push Gateway
WS_HEARTBEAT_INTERVAL=30000
